{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    // Node runs this package as native ESM ("type": "module"), so relative
    // imports are written with the .js extension the runtime actually resolves.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // The wire contract is its own package under protocol/. It is not installed
    // into node_modules - it is consumed straight from source here and bundled
    // in by esbuild - so the checker is pointed at it by hand. When it is
    // published to a registry, this mapping gives way to an ordinary dependency.
    "baseUrl": ".",
    "paths": {
      "@narraleaf/team-protocol": ["./protocol/src/index.ts"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    // An unused local is not a style question. Every one of the four found when
    // these were switched on was a leftover: three imports of things that had
    // moved, and one import of a constant naming the pinned loreserver version
    // that nothing compared against - which was a missing test rather than a
    // spare line, and is now tests/layout.test.ts's.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // esbuild produces dist/, so the compiler is only ever used as a checker.
    "noEmit": true,
    "skipLibCheck": true
  },
  // `scripts` holds one TypeScript file - the socket endpoint a real client is driven
  // at - and it is checked here rather than left out. The rest of that directory is
  // JavaScript, which this configuration does not look at either way.
  "include": ["src", "tests", "scripts", "protocol/src", "vitest.config.ts"]
}
