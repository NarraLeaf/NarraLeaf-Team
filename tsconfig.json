{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    // Node runs this package as native ESM ("type": "module"), so relative
    // imports are written with the .js extension the runtime actually resolves.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // The terminal interface is written in JSX, and React 19 supplies the
    // factory itself: with the automatic runtime there is no React import to
    // forget, which is the one mistake this setting exists to make impossible.
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // esbuild produces dist/, so the compiler is only ever used as a checker.
    "noEmit": true,
    "skipLibCheck": true
  },
  // `scripts` holds one TypeScript file - the socket endpoint a real client is driven
  // at - and it is checked here rather than left out. The rest of that directory is
  // JavaScript, which this configuration does not look at either way.
  "include": ["src", "tests", "scripts", "vitest.config.ts"]
}
